    {
      "id": "778db03d-f6ef-5b10-a02b-699c17af1df6",
      "name": "Turn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        -80
      ],
      "parameters": {
        "jsCode": "const ctx = $('Context').first().json.ctx;\nconst out = $input.first().json.output ?? {};\nconst steps = $input.first().json.intermediateSteps ?? [];\nconst reasons = ['user_request', 'complaint', 'medical', 'urgent'];\nconst trace = steps.map(s => ({ type: 'tool', data: {\n  tool: s.action?.tool, input: s.action?.toolInput,\n  output: (typeof s.observation === 'string' ? s.observation : JSON.stringify(s.observation ?? null)).slice(0, 1500) } }));\nconst failed = trace.some(t => t.data.output.includes('TOOL_ERROR'));\nconst asked = steps.find(s => s.action?.tool === 'escalate');\nconst escalate = failed ? 'tool_error'\n  : asked ? (reasons.includes(asked.action.toolInput?.reason) ? asked.action.toolInput.reason : 'user_request') : null;\nconst reply = String(out.reply ?? '').trim();\ntrace.push({ type: 'decision', data: { route: 'agent', understood: out.understood !== false, escalate, tools: trace.length } });\nreturn [{ json: {\n  execution_id: $execution.id,  // the trace points here: the agent run holds the full detail\n  reply: reply || (failed ? ctx.templates.fallback : ctx.templates.handoff),\n  understood: failed || !reply ? null : out.understood !== false,\n  escalate: escalate ?? (reply ? null : 'tool_error'),\n  trace } }];"
      }
    },
