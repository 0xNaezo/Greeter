        [
          {
            "node": "Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reindex": {
      "main": [
        [
          {
            "node": "Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Input": {
      "main": [
        [
          {
            "node": "Tenant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tenant": {
      "main": [
        [
          {
            "node": "Known tenant?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Known tenant?": {
      "main": [
        [
          {
            "node": "Articles",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Unknown tenant",
            "type": "main",
            "index": 0
          }
