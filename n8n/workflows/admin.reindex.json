{
  "id": "admin-reindex",
  "name": "admin.reindex",
  "nodes": [
    {
      "id": "313122bb-6108-5c7b-9160-ddbe2384ad71",
      "name": "Reindex request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        -80
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "admin/reindex",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-admin-token",
          "name": "Admin webhook token"
        }
      },
      "webhookId": "admin-reindex"
    },
    {
      "id": "85081fad-0959-55a3-a510-fdf4aefdbc59",
      "name": "Reindex",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        120
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "tenant",
              "type": "string"
            },
            {
              "name": "articles",
              "type": "array"
            }
          ]
        }
      }
    },
    {
      "id": "e7b3cbdb-0a6a-5d31-b8bb-c21653c3c453",
      "name": "Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        20
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "afad7277-3041-5b87-aadf-5de32d5c4c93",
              "name": "tenant",
              "value": "={{ $json.body?.tenant ?? $json.tenant }}",
              "type": "string"
            },
            {
              "id": "274b2aff-207f-5e31-8e37-f64993f502cf",
              "name": "articles",
              "value": "={{ $json.body?.articles ?? $json.articles ?? [] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3540aee8-529c-5a8a-a862-3d3d0a0633d0",
      "name": "Tenant",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        20
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select tenant_id_by_slug($1) as tenant_id",
        "options": {
          "queryReplacement": "={{ [ $json.tenant ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "cred-pg-app",
          "name": "Postgres app"
        }
      }
    },
    {
      "id": "0b604539-be90-5494-b774-7556deba1fd5",
      "name": "Known tenant?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        20
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "452c20e3-44e1-5cd8-b5ca-a56d01848c98",
              "leftValue": "={{ !!$json.tenant_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "94a8e8f6-2687-5ba1-aae3-3dcb517884ad",
      "name": "Unknown tenant",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        180
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "163eee3f-e105-5765-aaba-133ae1f74044",
              "name": "error",
              "value": "=unknown tenant {{ $('Input').first().json.tenant }}",
              "type": "string"
            },
            {
              "id": "678fee64-e1f0-5b7f-a547-9175d0af9339",
              "name": "chunks",
              "value": "={{ 0 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "4ab484db-11cd-5fd9-a7f1-a5169f761913",
      "name": "Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const tenant_id = $input.first().json.tenant_id;\nconst batch = String($execution.id);\nreturn ($('Input').first().json.articles ?? [])\n  .filter(a => String(a?.text ?? '').trim())\n  .map(a => ({ json: { tenant_id, batch, article: String(a.name ?? 'article'), text: String(a.text) } }));"
      }
    },
    {
      "id": "5970740f-2ee5-5d9f-b753-76d379d44093",
      "name": "Store chunks",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "insert",
        "tableName": "kb_chunks",
        "embeddingBatchSize": 50,
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "cred-pg-app",
          "name": "Postgres app"
        }
      }
    },
    {
      "id": "a8e6a914-63ca-5dcc-9d58-55d65c57fe7c",
      "name": "Article loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        1180,
        220
      ],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.text }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "tenant_id",
                "value": "={{ $json.tenant_id }}"
              },
              {
                "name": "article",
                "value": "={{ $json.article }}"
              },
              {
                "name": "batch",
                "value": "={{ $json.batch }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "1fc92af4-5261-5d4d-aaf8-1cf27412a276",
      "name": "Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1260,
        400
      ],
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 100,
        "options": {
          "splitCode": "markdown"
        }
      }
    },
    {
      "id": "c9c8f6e0-e6c9-5716-95db-acc5d9e7a50f",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        1020,
        220
      ],
      "parameters": {
        "model": "openai/text-embedding-3-small",
        "options": {
          "encodingFormat": "float",
          "batchSize": 50
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "cred-embeddings",
          "name": "Embeddings"
        }
      }
    },
    {
      "id": "6d0a6f2c-5a82-54ea-b18d-2ecaa6242861",
      "name": "Prune old chunks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select kb_prune($1::uuid, $2) as removed",
        "options": {
          "queryReplacement": "={{ [ $('Articles').first().json.tenant_id, $('Articles').first().json.batch ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "cred-pg-app",
          "name": "Postgres app"
        }
      },
      "executeOnce": true
    },
    {
      "id": "7f52fee9-0074-5732-ab7f-aad82db0ddf6",
      "name": "Indexed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "5ea922d0-0154-5633-b96e-2ff3de2feed6",
              "name": "tenant",
              "value": "={{ $('Input').first().json.tenant }}",
              "type": "string"
            },
            {
              "id": "495a2061-5d0c-5ec0-a735-a1579b385093",
              "name": "articles",
              "value": "={{ $('Articles').all().length }}",
              "type": "number"
            },
            {
              "id": "fbb6ba8d-6c13-596b-85b2-3b262886e89a",
              "name": "chunks",
              "value": "={{ $('Store chunks').all().length }}",
              "type": "number"
            },
            {
              "id": "3827f4c4-aa9d-527e-9736-ee63f1357edf",
              "name": "removed",
              "value": "={{ $json.removed }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "Store chunks",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Article loader": {
