            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "ops-error",
    "callerPolicy": "workflowsFromSameOwner",
    "saveManualExecutions": true
  },
  "pinData": {},
  "active": false,
  "meta": {
    "publish": true
  },
  "description": "Re-index a tenant knowledge base: POST /webhook/admin/reindex with X-Admin-Token, or as a sub-workflow; {tenant: slug, articles: [{name, text}]}. Articles are split, embedded and stored in kb_chunks with metadata {tenant_id, article, batch}; chunks of earlier runs are then pruned."
}
