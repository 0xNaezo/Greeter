      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -60
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.route.bot.api_base }}/bot{{ $json.route.bot.token }}/sendMessage",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.route.operator_chat_id, message_thread_id: Number($json.route.topic_id), text: '💬 ' + $json.route.client_name + ':\\n' + $('Batch').first().json.ctx.messages.map(m => m.text ?? '').join('\\n') }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
