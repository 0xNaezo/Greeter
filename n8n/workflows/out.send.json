    {
      "id": "d59c0240-7370-4087-b4ab-c1ce8e6a4750",
      "name": "Classify failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        160
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Delivery error -> what mark_sent needs. Built from the response only: the request URL carries the bot token.\nconst m = $('Load message').item.json.m;\nconst e = $json.error && typeof $json.error === 'object' ? $json.error : { message: String($json.error ?? 'unknown error') };\nconst body = e.error ?? e.response?.body ?? e.response?.data;\nconst text = [e.message, e.description, body && typeof body === 'object' ? JSON.stringify(body) : body]\n  .filter(Boolean).join(' ').replace(/bot\\d+:[\\w-]+/g, 'bot<token>').slice(0, 500);\nconst status = Number(e.statusCode ?? e.status ?? e.httpCode ?? e.response?.status ?? (text.match(/\\b([45]\\d\\d)\\b/) ?? [])[1] ?? 0);\nconst waCode = Number(body?.error?.code ?? 0);\n// the channel account itself is broken (token revoked, bot deleted): keep retrying, alert once per account\nconst account = m.channel === 'whatsapp'\n  ? status === 401 || status === 403 || [10, 190, 200].includes(waCode)\n  : status === 401 || status === 404;\n// this message can never be delivered (blocked, chat gone, 24 h window closed): drop it without an alert\nconst permanent = !account && (m.channel === 'whatsapp'\n  ? [131021, 131026, 131047].includes(waCode)\n  : status === 400 || status === 403 || /blocked|chat not found|deactivated/i.test(text));\nconst retryAfter = Number(body?.parameters?.retry_after ?? (text.match(/retry after (\\d+)/i) ?? [])[1] ?? 0) || null;\nreturn { json: { message_id: m.message_id, channel: m.channel, error: text, permanent, account, retry_after: retryAfter } };"
      }
    },
