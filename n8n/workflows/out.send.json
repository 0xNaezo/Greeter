    {
      "id": "21f72f0e-aa76-5abe-a60d-3b7eab941966",
      "name": "Telegram sendMessage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -60
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.m.api_base }}/bot{{ $json.m.token }}/sendMessage",
        "options": {
          "timeout": 10000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 50
            }
          }
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ chat_id: $json.m.chat_id, text: $json.m.text }, $json.m.buttons.length ? { reply_markup: { inline_keyboard: $json.m.buttons.map(row => row.map(b => ({ text: b.text, callback_data: b.data }))) } } : {})) }}"
      },
      "onError": "continueErrorOutput",
      "notes": "no retry: cron.reconcile retries with backoff (messages.next_attempt_at). A node retry would resend every item of a batch when the first one fails."
    },
    {
      "id": "737b4217-1643-5baa-8234-37cec87b81be",
      "name": "WhatsApp send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        160
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.m.api_base }}/{{ $json.m.external_id }}/messages",
        "options": {
          "timeout": 10000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 50
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.m.token }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const m = $json.m; const b = m.buttons.flat(); const base = { messaging_product: 'whatsapp', to: m.chat_id }; if (!b.length) return JSON.stringify({ ...base, type: 'text', text: { body: m.text } }); if (b.length <= 3) return JSON.stringify({ ...base, type: 'interactive', interactive: { type: 'button', body: { text: m.text }, action: { buttons: b.map(x => ({ type: 'reply', reply: { id: x.data, title: x.text.slice(0, 20) } })) } } }); return JSON.stringify({ ...base, type: 'interactive', interactive: { type: 'list', body: { text: m.text }, action: { button: 'Choose', sections: [{ title: 'Options', rows: b.slice(0, 10).map(x => ({ id: x.data, title: x.text.slice(0, 24) })) }] } } }); })() }}"
      },
      "onError": "continueErrorOutput",
      "notes": "no retry: cron.reconcile retries with backoff (messages.next_attempt_at). A node retry would resend every item of a batch when the first one fails."
    },
    {
      "id": "c2595c48-1953-54b8-9b37-a86d3c06dd44",
