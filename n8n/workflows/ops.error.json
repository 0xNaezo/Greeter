          }
        ]
      ]
    },
    "From failure": {
      "main": [
        [
          {
            "node": "Record incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report": {
      "main": [
        [
          {
            "node": "Record incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Replayable?": {
      "main": [
