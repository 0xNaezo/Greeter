            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "saveManualExecutions": true
  },
  "pinData": {},
  "active": false,
  "meta": {
    "publish": true
  },
  "description": "Every failed execution and every problem a workflow reports (Report input): record an incident, alert the platform chat (deduplicated per workflow/node for 10 minutes); failed executions get a Replay button."
}
