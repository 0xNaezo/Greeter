    {
      "id": "85a0caef-d202-561e-8694-52e377c6ad95",
      "name": "Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        80
      ],
      "parameters": {
        "jsCode": "// Meta webhook payload -> one item per client message of this phone number (statuses are ignored)\nconst body = $('WhatsApp webhook').first().json.body ?? {};\nconst acc = $('Check account').first().json.acc;\nconst out = [];\nfor (const entry of body.entry ?? []) for (const change of entry.changes ?? []) {\n  const v = change.value ?? {};\n  if (String(v.metadata?.phone_number_id) !== String(acc.external_id)) continue;\n  const names = Object.fromEntries((v.contacts ?? []).map(c => [c.wa_id, c.profile?.name]));\n  for (const m of v.messages ?? []) {\n    const reply = m.interactive?.button_reply ?? m.interactive?.list_reply ?? (m.button ? { id: m.button.payload, title: m.button.text } : null);\n    out.push({ json: {\n      account_id: acc.account_id, tenant_id: acc.tenant_id, user_id: String(m.from), chat_id: String(m.from), external_id: String(m.id),\n      text: reply ? '[button] ' + (reply.title ?? reply.id) : (m.text?.body ?? '[' + (m.type ?? 'unsupported message') + ']'),\n      payload: reply ? { callback: String(reply.id) } : {},\n      profile: { first_name: names[m.from] ?? null } } });\n  }\n}\nreturn out;"
      }
    },
