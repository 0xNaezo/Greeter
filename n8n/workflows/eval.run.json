    {
      "id": "52d0f00f-6b6d-5942-905c-13466c523121",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        480
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.scenario);\nconst info = $('Eval tenant').first().json.e ?? {};\nconst done = rows.filter(r => r.result);\nconst passed = done.filter(r => r.result === 'pass');\nconst pct = (a, b) => b ? (100 * a / b).toFixed(1) + '%' : '-';\nconst cats = {};\nfor (const r of done) { const c = cats[r.category] ??= { n: 0, ok: 0 }; c.n++; if (r.result === 'pass') c.ok++; }\nconst date = new Date().toISOString().slice(0, 10);\nconst md = [\n  `# Eval report ${date}`, '',\n  `Tenant \\`${info.slug}\\`, LLM profile \\`${info.llm_profile}\\`${Object.keys(info.models ?? {}).length ? ', models ' + JSON.stringify(info.models) : ''}.`,\n  `Scenarios: ${done.length} of ${rows.length}. Passed: ${passed.length} (${pct(passed.length, done.length)}), threshold 90%.`, '',\n  '| Category | Passed |', '| --- | --- |',\n  ...Object.entries(cats).map(([c, v]) => `| ${c} | ${v.ok} / ${v.n} (${pct(v.ok, v.n)}) |`), '',\n  '## Failures', '',\n  ...(done.filter(r => r.result !== 'pass').map(r => `- **${r.scenario}** (${r.category}): ${String(r.details).replace(/\\|/g, '/')}`)),\n  done.length === passed.length ? '- none' : '', ''];\nreturn [{ json: { file: `/reports/eval-${date}.md`, pass_rate: done.length ? passed.length / done.length : null,\n                  scenarios: done.length, passed: passed.length, text: md.join('\\n') } }];"
      }
    },
