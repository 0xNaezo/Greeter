    {
      "id": "5555a5c3-c9d8-5ba8-b15f-3da4a7496d7d",
      "name": "Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// checks of one scenario; a check that does not apply counts as passed in its own metric\nconst row = $('Scenario').first().json;\nconst expect = JSON.parse(row.expect || '{}');\nconst turns = $('Run turns').all().map(i => i.json.t ?? {});\nconst state = $('Final state').first().json.s ?? {};\nconst used = [...new Set(turns.flatMap(t => t.tools ?? []))];\nconst replies = turns.map(t => t.reply ?? '').join('\\n');\nconst escalations = turns.map(t => t.escalate ?? (t.streak >= 2 ? 'not_understood' : null)).filter(Boolean);\nconst m = { tools: 1, escalation: 1, outcome: 1, prices: 1, language: 1, content: 1 };\nconst fail = [];\nconst missing = (expect.tools ?? []).filter(t => !used.includes(t));\nconst forbidden = (expect.no_tools ?? []).filter(t => used.includes(t));\nif (missing.length) { m.tools = 0; fail.push('missing tools: ' + missing.join(', ')); }\nif (forbidden.length) { m.tools = 0; fail.push('forbidden tools used: ' + forbidden.join(', ')); }\nif ('escalate' in expect) {\n  const ok = expect.escalate === false ? !escalations.length : escalations.includes(expect.escalate);\n  if (!ok) { m.escalation = 0; fail.push(`escalation: expected ${expect.escalate}, got ${escalations.join(', ') || 'none'}`); }\n}\nif (expect.outcome) {\n  const got = state.booked > 0 ? 'booked' : state.cancelled > 0 ? 'cancelled' : state.moved > 0 ? 'moved' : 'none';\n  if (got !== expect.outcome) { m.outcome = 0; fail.push(`outcome: expected ${expect.outcome}, got ${got}`); }\n}\n// every amount written next to a currency must be a price from the clinic price list\nconst prices = new Set((state.prices ?? []).map(Number));\nconst amounts = [...replies.matchAll(/(\\d[\\d\\s.,]*\\d|\\d)\\s*(?:UAH|грн|гривень|гривен|гривні|₴|hryvnias?)/gi)]\n  .map(x => Number(x[1].replace(/[\\s,]/g, '').replace(/\\.0+$/, '')));\nconst invented = amounts.filter(a => !prices.has(a));\nif (invented.length) { m.prices = 0; fail.push('amounts not on the price list: ' + invented.join(', ')); }\nif (expect.lang) {\n  const want = [].concat(expect.lang);\n  const langs = turns.map(t => t.lang).filter(Boolean);\n  if (!langs.every(l => want.includes(l))) { m.language = 0; fail.push(`language: expected ${want.join('/')}, got ${langs.join(', ')}`); }\n}\nif (expect.contains && !new RegExp(expect.contains, 'i').test(replies)) { m.content = 0; fail.push(`reply does not match /${expect.contains}/`); }\nif (expect.not_contains && new RegExp(expect.not_contains, 'i').test(replies)) { m.content = 0; fail.push(`reply matches forbidden /${expect.not_contains}/`); }\nreturn [{ json: { ...m, pass: fail.length ? 0 : 1, scenario: row.scenario, category: row.category,\n  details: fail.length ? fail.join('; ') + ' | replies: ' + replies.replace(/\\s+/g, ' ').slice(0, 500) : 'ok' } }];"
      }
    },
