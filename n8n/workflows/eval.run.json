    {
      "id": "dd55744d-c15a-5a59-8f84-a9e4a671f9e9",
      "name": "Final state",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select eval_state($1::uuid) as s",
        "options": {
          "queryReplacement": "={{ [ $('Run turns').first().json.conversation_id ] }}"
        }
