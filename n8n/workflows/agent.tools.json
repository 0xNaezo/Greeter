        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'openai/text-embedding-3-small', input: String($json.args?.query ?? '').replace(/\\n/g, ' '), encoding_format: 'float' }) }}",
        "options": {
          "timeout": 8000
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "cred-embeddings",
          "name": "Embeddings"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput",
      "notes": "Same endpoint and model as admin.reindex (cred-embeddings). A plain request, because the embeddings node retries up to 6 times with backoff and blows the turn budget."
    },
