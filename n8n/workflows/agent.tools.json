      "typeVersion": 2.6,
      "position": [
        500,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select find_slots($1::uuid, $2, $3, $4, $5, $6) as r",
        "options": {
          "queryReplacement": "={{ [ $('Tool call').first().json.tenant_id, $('Tool call').first().json.args.service ?? '', $('Tool call').first().json.args.branch ?? '', $('Tool call').first().json.args.doctor || null, $('Tool call').first().json.args.date_from || null, $('Tool call').first().json.args.date_to || null ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "cred-pg-app",
          "name": "Postgres app"
        }
      },
      "onError": "continueErrorOutput"
    },
