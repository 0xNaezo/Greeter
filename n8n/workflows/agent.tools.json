    {
      "id": "42c04191-8026-5b8d-bc4a-0984b7591f43",
      "name": "Articles found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        -420
      ],
      "parameters": {
        "jsCode": "const docs = $input.first().json.r ?? [];\nreturn [{ json: { result: docs.length\n  ? docs.map(d => `[${d.article ?? 'article'}] ${d.text}`).join('\\n\\n')\n  : 'Nothing about this in the knowledge base. Do not guess: say you do not know and offer an administrator.' } }];"
      }
    },
