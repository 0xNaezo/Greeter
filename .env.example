# Copy to .env, or let scripts/bootstrap.sh do it: it fills every empty secret marked "generated".
# Empty external keys are fine for local work: the demo tenant then talks to the stub
# (fake Telegram / LLM / Google Calendar / WhatsApp) until real keys are added and bootstrap is re-run.
TZ=Europe/Kyiv
# Compose profiles: dev = stub, production = empty (add "tunnel" for a dev https URL)
COMPOSE_PROFILES=stub

# --- Postgres (db "n8n" for n8n itself, db "app" for the application)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
# generated: role "app" (n8n workflows), "grafana_ro" (dashboards), "nocodb" (admin grids)
APP_DB_PASSWORD=
GRAFANA_DB_PASSWORD=
NOCODB_DB_PASSWORD=

# --- n8n
# Encrypts credentials stored in n8n. Losing it = losing all saved credentials. (generated)
N8N_ENCRYPTION_KEY=
# Public HTTPS URL for inbound webhooks (Telegram etc.), e.g. a tunnel. Defaults to http://localhost:5678/
WEBHOOK_URL=
# ssh -R 80:localhost:8080 nokey@localhost.run

# generated: n8n owner (also the NocoDB admin login)
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=
N8N_WORKERS=2
N8N_WORKER_CONCURRENCY=20

# --- Application secrets (generated)
# pgcrypto key for channel tokens stored in db "app"
APP_ENCRYPTION_KEY=
# signs web widget session tokens
WIDGET_HMAC_SECRET=
# guards internal admin webhooks (knowledge base re-index)
ADMIN_TOKEN=
# secret_token of the platform bot webhook (Replay buttons in error alerts)
PLATFORM_TG_WEBHOOK_SECRET=

# --- LLM providers. OpenRouter (https://openrouter.ai/settings/keys) runs the chat model and the knowledge base
# embeddings; Groq (https://console.groq.com/keys, free tier) is the fallback model. With neither key the tenants
# talk to the stub LLM. Models per clinic: config.models in tenants/<slug>/tenant.json.
# Give the OpenRouter key a credit limit (key settings): every web widget message is a paid LLM turn.
# bootstrap writes EMBEDDINGS_API_URL (OpenRouter with a key, else the stub) for the knowledge base search.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Telegram
# Demo clinic bot; empty = stub. The bot must be admin of the operator supergroup (topics on, can_manage_topics).
DEMO_TG_BOT_TOKEN=
DEMO_TG_OPERATOR_CHAT_ID=
# Platform bot: error alerts with a Replay button, sent to PLATFORM_TG_CHAT_ID (a group or your own chat with the bot).
# May be the same token as DEMO_TG_BOT_TOKEN.
PLATFORM_TG_BOT_TOKEN=
PLATFORM_TG_CHAT_ID=

# --- Google Calendar (service account; share each branch/doctor calendar with GOOGLE_SA_EMAIL)
GOOGLE_SA_EMAIL=
# "private_key" of the service account JSON key, in double quotes, with its literal \n line breaks
GOOGLE_SA_PRIVATE_KEY=
DEMO_GCAL_CENTER=
DEMO_GCAL_PODIL=

# --- WhatsApp Cloud API (P1). One Meta app for the platform; each clinic adds its phone number.
# Meta webhook: callback https://<domain>/webhook/wa/<account id>, verify token = that account's webhook_secret
WA_APP_SECRET=
DEMO_WA_PHONE_NUMBER_ID=
DEMO_WA_TOKEN=

# --- Grafana / NocoDB (generated passwords, login "admin" / N8N_OWNER_EMAIL)
GRAFANA_ADMIN_PASSWORD=
NOCODB_ADMIN_PASSWORD=
NOCODB_JWT_SECRET=
# Grafana public URL; defaults to http://localhost:8080/grafana/
# GRAFANA_ROOT_URL=

# --- Stub LLM latency range in ms (load tests)
# STUB_LLM_DELAY_MS=1000-3000

# --- Caddy: dev serves http://localhost:8080; production sets the domain for automatic TLS
SITE_ADDRESS=:80
# Clinic sites that embed the web widget (CORS), space-separated in double quotes (bootstrap sources this file):
# WIDGET_ORIGINS="https://smile.example https://www.smile.example". The demo page is same-origin and needs no entry.
WIDGET_ORIGINS=
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
