# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
TZ=Europe/Kyiv

POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# Encrypts credentials stored in n8n. Losing it = losing all saved credentials.
N8N_ENCRYPTION_KEY=

# Public HTTPS URL for inbound webhooks (Telegram etc.), e.g. a tunnel. Defaults to http://localhost:5678/
# WEBHOOK_URL=
