          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dialog → booking",
      "description": "Share of dialogs in which the client booked a visit.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "app-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "app-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select 100.0 * count(*) filter (where booked) / nullif(count(*), 0) from dash.sessions where tenant_id = '$tenant' and $__timeFilter(started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "—",
          "color": {
            "mode": "fixed",
