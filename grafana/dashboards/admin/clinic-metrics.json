          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select $__timeGroupAlias(started_at, 1d), count(*) as \"Dialogs\" from dash.sessions where tenant_id = '$tenant' and $__timeFilter(started_at) group by 1 order by 1"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
