          "rawSql": "select $__timeGroupAlias(created_at, 1d), count(*) as \"Bookings\" from dash.appointments where tenant_id = '$tenant' and ('$branch' = 'all' or branch_id::text = '$branch') and source <> 'admin' and $__timeFilter(created_at) group by 1 order by 1"
