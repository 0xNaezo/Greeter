          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select $__timeGroupAlias(at, 1d), percentile_cont(0.5) within group (order by seconds) as \"median\", percentile_cont(0.95) within group (order by seconds) as \"p95\" from dash.response_times where tenant_id = '$tenant' and $__timeFilter(at) group by 1 order by 1"
