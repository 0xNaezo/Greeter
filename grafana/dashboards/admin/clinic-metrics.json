        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "No-shows",
      "description": "No-shows among visits that took place in the period.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "app-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "app-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select 100.0 * count(*) filter (where status = 'no_show') / nullif(count(*) filter (where status in ('done', 'no_show')), 0) from dash.appointments where tenant_id = '$tenant' and ('$branch' = 'all' or branch_id::text = '$branch') and $__timeFilter(starts_at)"
        }
