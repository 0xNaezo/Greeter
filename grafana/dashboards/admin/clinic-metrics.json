            "type": "grafana-postgresql-datasource",
            "uid": "app-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select percentile_cont(0.95) within group (order by seconds) from dash.response_times where tenant_id = '$tenant' and $__timeFilter(at)"
