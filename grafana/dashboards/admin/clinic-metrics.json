          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select 100.0 * count(*) filter (where not escalated) / nullif(count(*), 0) from dash.sessions where tenant_id = '$tenant' and $__timeFilter(started_at)"
        }
