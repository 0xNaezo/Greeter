    {
      "id": 6,
      "type": "stat",
      "title": "Reply time p95",
      "description": "95th percentile from a client message to the assistant answer (target ≤ 6 s).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "app-pg"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 3,
        "h": 4
      },
