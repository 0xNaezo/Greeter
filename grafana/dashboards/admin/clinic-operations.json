            "uid": "app-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select starts_at as \"Visit\", client as \"Client\", phone as \"Phone\", service as \"Service\", doctor as \"Doctor\", branch as \"Branch\", status as \"Status\", source as \"Source\", confirmed as \"Confirmed\", in_calendar as \"In calendar\", price as \"Price\", review_score as \"Review\" from dash.appointments where tenant_id = '$tenant' and ('$branch' = 'all' or branch_id::text = '$branch') and $__timeFilter(starts_at) order by starts_at desc limit 300"
