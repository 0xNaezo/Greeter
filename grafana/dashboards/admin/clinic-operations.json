      "type": "table",
      "title": "Open incidents (all clinics)",
      "description": null,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "app-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "app-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select id as \"#\", created_at as \"At\", workflow as \"Workflow\", node as \"Node\", error as \"Error\", execution_id as \"Execution\" from dash.incidents where status = 'open' order by id desc limit 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Dialogs",
      "description": "Click a session id to open its trace.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "app-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "app-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select started_at as \"Started\", channel as \"Channel\", messages_in as \"In\", messages_out as \"Out\", escalated as \"Operator\", booked as \"Booked\", round(llm_cost_usd::numeric, 4) as \"LLM $\", id::text as session_id from dash.sessions where tenant_id = '$tenant' and $__timeFilter(started_at) order by started_at desc limit 300"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "session_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "/grafana/d/greeter-trace/trace?var-session=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
